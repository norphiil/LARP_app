# Configuration du serveur
NODE_ENV=development
PORT=3000
HOST=localhost
JWT_SECRET=your-super-secret-jwt-key-change-in-production
DATABASE_PATH=./database.db

# HOST options:
# - localhost : Écouter seulement sur localhost (par défaut)
# - 0.0.0.0 : Écouter sur toutes les interfaces réseau

# Configuration du logging
ENABLE_LOGGING=true
LOG_LEVEL=info
LOG_TO_FILE=true

# Niveaux de log disponibles :
# - debug : Toutes les informations (très verbeux)
# - info  : Informations générales (recommandé)
# - warn  : Avertissements et erreurs
# - error : Erreurs uniquement

# LOG_TO_FILE=true : Écrire les logs dans ./logs/
# LOG_TO_FILE=false : Logs uniquement en console
