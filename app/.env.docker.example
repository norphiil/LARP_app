# Fichier de variables d'environnement pour Docker Compose
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins

# JWT Secret pour la production - CHANGEZ CETTE VALEUR !
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-characters

# Configuration du serveur
NODE_ENV=production
PORT=3000

# Configuration de la base de données
DATABASE_PATH=/app/data/database.db

# Configuration réseau (si nécessaire)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000

# Logs
LOG_LEVEL=info
